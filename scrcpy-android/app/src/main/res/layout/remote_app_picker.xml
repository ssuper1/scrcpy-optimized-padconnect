<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_picker"
    android:padding="16dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_picker_title"
            android:textColor="@color/on_surface"
            android:textSize="20sp"
            android:textStyle="bold"
            android:accessibilityHeading="true"/>

        <ImageButton
            android:id="@+id/close_app_picker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_app_picker"/>
    </LinearLayout>

    <EditText
        android:id="@+id/app_search"
        style="@style/Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/search_apps"
        android:inputType="textFilter"
        android:singleLine="true"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:importantForAutofill="no"
        android:textSize="14sp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/remote_app_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:listSelector="@android:color/transparent"
            android:clipToPadding="false"
            android:paddingBottom="4dp"
            android:scrollbars="vertical"/>

        <TextView
            android:id="@+id/no_matching_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/no_matching_apps"
            android:textColor="@color/on_surface_muted"
            android:textSize="15sp"/>
    </FrameLayout>
</LinearLayout>
